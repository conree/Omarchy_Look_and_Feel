{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy-look-and-feel.local/schema/catalog-entry-v1.json",
  "title": "Omarchy Look & Feel catalog entry",
  "description": "Read-only discovered catalog metadata. An entry is selectable only after its source, compatibility, and license requirements have been reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "source", "license", "licenseEvidence", "provenanceVerified", "review", "compatibility", "selectable"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(font|theme|unlock|background|icon):[a-z0-9-]+-[a-f0-9]{12}$"
    },
    "kind": { "enum": ["font", "theme", "unlock", "background", "icon"] },
    "name": { "type": "string", "minLength": 1 },
    "monospace": { "type": "boolean" },
    "source": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "preview": { "type": ["string", "null"], "minLength": 1 },
    "license": { "type": ["string", "null"] },
    "licenseEvidence": { "type": ["string", "null"], "format": "uri" },
    "provenanceVerified": { "type": "boolean" },
    "review": { "type": "string", "minLength": 1 },
    "developmentOnly": { "type": "boolean" },
    "compatibility": { "enum": ["pending", "verified", "not-required"] },
    "selectable": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "selectable": { "const": true }, "developmentOnly": { "not": { "const": true } } },
        "required": ["selectable"]
      },
      "then": {
        "properties": {
          "license": { "type": "string", "minLength": 1 },
          "licenseEvidence": { "type": "string", "format": "uri", "minLength": 1 },
          "provenanceVerified": { "const": true },
          "review": { "const": "verified" }
        }
      }
    },
    {
      "if": {
        "properties": { "selectable": { "const": true }, "developmentOnly": { "const": true } },
        "required": ["selectable", "developmentOnly"]
      },
      "then": { "properties": { "review": { "const": "development-approved" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "theme" } }, "required": ["kind"] },
      "then": {
        "if": { "properties": { "selectable": { "const": true } }, "required": ["selectable"] },
        "then": { "properties": { "compatibility": { "const": "verified" } } }
      },
      "else": { "properties": { "compatibility": { "const": "not-required" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "unlock" } }, "required": ["kind"] },
      "then": {
        "properties": { "preview": { "type": "string", "minLength": 1 } },
        "required": ["preview"]
      }
    }
  ]
}
