{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy-look-and-feel.local/schema/font-application-inventory-v3.json",
  "title": "Installed application font surface inventory",
  "type": "object",
  "required": [
    "schemaVersion",
    "scope",
    "desktopEntryFilesFound",
    "effectiveDesktopApplications",
    "visibleDesktopApplications",
    "frameworkIdentifiedVisibleApplications",
    "frameworkIdentificationPercent",
    "frameworkIdentificationScope",
    "applicationCandidateCoverage",
    "applicationCandidates",
    "hiddenOrNoDisplayEntries",
    "unavailableTryExecEntries",
    "additionalInstalledCliTuis",
    "desktopApplications",
    "installationSources",
    "standaloneApplications",
    "webApplications",
    "mailClients",
    "cliTuis",
    "shellSurfaces",
    "reviewCounts",
    "sharedFontSurfaces",
    "knownNotInstalled",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "scanCompletedAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "string" },
    "desktopEntryFilesFound": { "type": "integer", "minimum": 0 },
    "effectiveDesktopApplications": { "type": "integer", "minimum": 0 },
    "visibleDesktopApplications": { "type": "integer", "minimum": 0 },
    "frameworkIdentifiedVisibleApplications": { "type": "integer", "minimum": 0 },
    "frameworkIdentificationPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "frameworkIdentificationScope": { "type": "string" },
    "applicationCandidateCoverage": {
      "type": "object",
      "required": ["discovered", "frameworkIdentified", "percent", "bySource", "sourceStatus", "scope", "appImageLauncherDuplicatesExcluded"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "frameworkIdentified": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "bySource": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "sourceStatus": { "type": "object", "additionalProperties": { "enum": ["available", "unavailable", "scanned"] } },
        "scope": { "type": "string" },
        "appImageLauncherDuplicatesExcluded": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "applicationCandidates": { "type": "array", "items": { "type": "object" } },
    "hiddenOrNoDisplayEntries": { "type": "integer", "minimum": 0 },
    "unavailableTryExecEntries": { "type": "integer", "minimum": 0 },
    "additionalInstalledCliTuis": { "type": "integer", "minimum": 0 },
    "desktopApplications": { "type": "array", "items": { "type": "object" } },
    "installationSources": { "type": "object" },
    "standaloneApplications": { "type": "array", "items": { "type": "object" } },
    "webApplications": { "type": "array", "items": { "type": "object" } },
    "mailClients": { "type": "array", "items": { "type": "object" } },
    "cliTuis": { "type": "array", "items": { "type": "object" } },
    "shellSurfaces": { "type": "object" },
    "reviewCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "sharedFontSurfaces": { "type": "object" },
    "knownNotInstalled": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
